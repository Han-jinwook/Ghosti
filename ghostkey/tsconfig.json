{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../src/*"],
      "@capacitor/core": ["./node_modules/@capacitor/core", "../node_modules/@capacitor/core"],
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js", "../node_modules/@supabase/supabase-js"],
      "lucide-react": ["./node_modules/lucide-react", "../node_modules/lucide-react"],
      "react": ["./node_modules/@types/react", "../node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*", "../node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom", "../node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*", "../node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src"]
}

# ============================================================================
# ⚡ 제트아이 (Z-Eye) 로컬 환경변수 템플릿 (.env.example)
# 실제 키 값은 절대 Git에 커밋하지 말고 로컬 전용 `.env.local`에만 입력하세요.
# ============================================================================

# 1. AI 엔진 & 멀티모달 추론 (로컬 백엔드 전용)
GEMINI_API_KEY=

# 2. Supabase (Zero-Cloud 경량 스키마 & Realtime Broadcast 0-Byte P2P 시그널링)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. 멀린 패밀리 허브 (Merlin Hub SSO & 통합 코인 에스크로 API)
VITE_MERLIN_HUB_URL=https://os.sundreamer.app

# 4. Microsoft Artifact Signing (썬드림주식회사 Windows .exe 무인 자동 코드사인)
# 로컬 패키징 스크립트에서 Azure CLI / signtool.exe 호출 시에만 참조 (Git 추적 원천 차단)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ARTIFACT_SIGNING_ENDPOINT=https://eus.codesigning.azure.net/
ARTIFACT_SIGNING_ACCOUNT_NAME=
ARTIFACT_SIGNING_CERT_PROFILE_NAME=
